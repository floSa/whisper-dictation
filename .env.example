# Configuration du serveur Whisper partagé
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=Systran/faster-whisper-large-v3
WHISPER_LANGUAGE=fr

# Raccourci clavier global (ex: <f8>, <ctrl>+<alt>+<space>, <ctrl>+<shift>+d)
DICTATION_HOTKEY=<f8>

# Mode de dictée : toggle (appui = start, réappui = stop) ou push_to_talk (maintenir)
DICTATION_MODE=toggle

# Sons de retour (bips de confirmation) : true / false
AUDIO_FEEDBACK=true

# Prompt initial pour guider le modèle sur les acronymes et anglicismes techniques
INITIAL_PROMPT=Docker, API, GPU, CUDA, CI/CD, PR, WSL, LLM, Python, PyTest, Git, TypeScript, Linux, Kubernetes, VS Code, CTranslate2, Speaches
